datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  BUSINESS_OWNER
  CUSTOMER
}

enum PromotionStatus {
  ACTIVE
  PENDING
  EXPIRED
}

enum PromotionType {
  FEATURED_BUSINESS
  HOMEPAGE_FEATURED
  CATEGORY_FEATURED
  SPONSORED_OFFER
  FESTIVAL_CAMPAIGN
  BUSINESS_OF_THE_WEEK
}

enum OrderStatus {
  PENDING
  WHATSAPP_DISPATCHED
  COMPLETED
  CANCELLED
}

enum PointTransactionType {
  EARNED
  REDEEMED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  phone        String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Category {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  iconName      String
  description   String
  itemCount     Int      @default(0)
  badge         String?
  colorGradient String   @default("bg-blue-600")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
}

model Business {
  id             String      @id @default(uuid())
  name           String
  categorySlug   String
  subCategory    String
  rating         Float       @default(4.5)
  reviewCount    Int         @default(1)
  address        String
  landmark       String
  phone          String
  whatsapp       String?
  timing         String      @default("09:00 AM - 09:00 PM")
  isVerified     Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  promotionType  String?
  promotionLabel String?
  image          String
  description    String?
  priceRange     String?
  ownerName      String?
  lat            Float?
  lng            Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  galleryImages BusinessImage[]
  tags          BusinessTag[]
  reviews       Review[]
  promotions    Promotion[]

  @@index([categorySlug])
  @@index([isVerified])
  @@index([isFeatured])
  @@index([name])
}

model BusinessImage {
  id         String   @id @default(uuid())
  businessId String
  imageUrl   String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessTag {
  id         String @id @default(uuid())
  businessId String
  tag        String

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model PhotographyBusiness {
  id               String   @id @default(uuid())
  name             String
  profileImage     String
  coverImage       String
  location         String
  landmark         String?
  phone            String
  whatsapp         String?
  instagram        String?
  description      String
  photographyTypes String[] // Stored as Array of String types
  startingPrice    String?
  openingHours     String   @default("09:00 AM - 09:00 PM")
  isVerified       Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  rating           Float    @default(4.9)
  reviewCount      Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  galleryImages PhotographyImage[]

  @@index([isVerified])
  @@index([isFeatured])
  @@index([name])
}

model PhotographyImage {
  id            String              @id @default(uuid())
  photographyId String
  imageUrl      String
  createdAt     DateTime            @default(now())

  photography   PhotographyBusiness @relation(fields: [photographyId], references: [id], onDelete: Cascade)
}

model Promotion {
  id            String          @id @default(uuid())
  businessId    String?
  businessName  String
  promotionType PromotionType   @default(HOMEPAGE_FEATURED)
  placement     String          @default("Homepage Top Banner")
  startDate     String
  endDate       String
  priority      Int             @default(1)
  status        PromotionStatus @default(ACTIVE)
  badgeLabel    String?         @default("PROMOTED")
  bannerImage   String?
  title         String?
  description   String?
  offerText     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([promotionType])
}

model Offer {
  id           String   @id @default(uuid())
  title        String
  businessName String
  discount     String
  code         String?
  expiry       String
  image        String
  tag          String
  categorySlug String
  location     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categorySlug])
}

model FoodMenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  description  String
  price        Float
  isVeg        Boolean  @default(false)
  category     String
  image        String
  rating       Float?   @default(4.5)
  isBestseller Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([restaurantId])
  @@index([isVeg])
  @@index([category])
}

model Order {
  id              String      @id @default(uuid())
  customerName    String
  customerPhone   String
  deliveryAddress String
  landmark        String?
  notes           String?
  totalAmount     Float
  status          OrderStatus @default(WHATSAPP_DISPATCHED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]

  @@index([customerPhone])
  @@index([status])
}

model OrderItem {
  id           String @id @default(uuid())
  orderId      String
  foodItemId   String
  name         String
  price        Float
  quantity     Int
  businessName String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model JobListing {
  id           String   @id @default(uuid())
  title        String
  category     String
  shopName     String
  location     String
  salary       String
  type         String   @default("Full-time")
  experience   String
  phone        String
  whatsapp     String?
  postedDate   String
  description  String
  requirements String[]
  isVerified   Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([isVerified])
}

model RealEstateProperty {
  id           String          @id @default(uuid())
  title        String
  type         String // Buy, Rent, Lease, Sell
  category     String // Plot, House, Commercial, Agriculture
  price        String
  pricePerSqft String?
  areaSqft     Int
  location     String
  bedrooms     Int?
  bathrooms    Int?
  features     String[]
  ownerName    String
  ownerPhone   String
  whatsapp     String?
  postedDate   String
  isVerified   Boolean         @default(true)
  isFeatured   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  images PropertyImage[]

  @@index([type])
  @@index([category])
}

model PropertyImage {
  id         String             @id @default(uuid())
  propertyId String
  imageUrl   String
  createdAt  DateTime           @default(now())

  property RealEstateProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Hospital {
  id               String   @id @default(uuid())
  name             String
  tagline          String
  address          String
  landmark         String
  emergencyPhone   String
  appointmentPhone String
  timing           String
  image            String
  departments      String[]
  facilities       String[]
  is24x7           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  doctors Doctor[]
}

model Doctor {
  id              String    @id @default(uuid())
  hospitalId      String?
  name            String
  qualification   String
  specialization  String
  experienceYears Int
  hospitalName    String
  hospitalAddress String
  timings         String
  consultationFee String
  phone           String
  whatsapp        String?
  image           String
  availableDays   String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  @@index([specialization])
}

model ServiceProvider {
  id              String   @id @default(uuid())
  name            String
  serviceCategory String
  subCategory     String?
  area            String
  rating          Float    @default(4.8)
  reviewCount     Int      @default(1)
  experienceYears Int?
  startingPrice   String?
  phone           String
  whatsapp        String?
  timing          String
  isVerified      Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  image           String
  description     String
  servicesOffered String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([serviceCategory])
}

model ServiceRequest {
  id              String   @id @default(uuid())
  customerName    String
  customerPhone   String
  serviceCategory String
  providerName    String?
  address         String
  preferredTime   String
  message         String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  businessId String
  userName   String
  rating     Float
  comment    String
  date       String
  ownerReply String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model RoyalPointTransaction {
  id        String               @id @default(uuid())
  userId    String?
  amount    Int
  type      PointTransactionType @default(EARNED)
  reason    String
  timestamp String
  createdAt DateTime             @default(now())
}

model RewardVoucher {
  id            String   @id @default(uuid())
  title         String
  businessName  String
  pointsCost    Int
  valueDiscount String
  image         String
  expiry        String
  code          String
  createdAt     DateTime @default(now())
}

model StoryReel {
  id          String   @id @default(uuid())
  title       String
  businessName String
  thumbImage  String
  mediaType   String   @default("image") // image or video
  viewsCount  Int      @default(0)
  isNew       Boolean  @default(true)
  linkUrl     String?
  createdAt   DateTime @default(now())
}

model HeroSlide {
  id         String   @id @default(uuid())
  title      String
  subtitle   String
  image      String
  badgeText  String
  badgeColor String?  @default("bg-blue-600")
  ctaText    String   @default("Explore Deals")
  ctaLink    String   @default("/offers")
  businessId String?
  priority   Int      @default(1)
  createdAt  DateTime @default(now())
}

model EmergencyContact {
  id            String   @id @default(uuid())
  name          String
  category      String
  phone         String
  address       String
  available24x7 Boolean  @default(true)
  createdAt     DateTime @default(now())
}
